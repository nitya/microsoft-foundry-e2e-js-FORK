# ──────────────────────────────────────────────────────────
# Microsoft Foundry E2E Quest – Python Labs
# Copy this file to .env and fill in your values.
# Run labs/scripts/setup-env.sh to auto-populate most values.
# ──────────────────────────────────────────────────────────

# ── Required ─────────────────────────────────────────────
# Your Foundry project endpoint (found on the project Overview page)
AZURE_AI_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>

# The deployment name of the model you want to use (e.g. gpt-4.1)
MODEL_DEPLOYMENT_NAME=gpt-4.1

# ── Optional: Red-Teaming (Task 08) ─────────────────────
# MODEL_ENDPOINT=https://<account>.services.ai.azure.com
# MODEL_API_KEY=

# ── Optional: Tracing / Application Insights (Task 07) ──
# TELEMETRY_CONNECTION_STRING=

# ── Optional: Fine-Tuning Deployment (Task 04c) ─────────
# AZURE_AI_PROJECTS_AZURE_SUBSCRIPTION_ID=
# AZURE_AI_PROJECTS_AZURE_RESOURCE_GROUP=
# AZURE_AI_PROJECTS_AZURE_AOAI_ACCOUNT=

# ── Optional: Reduce SDK log noise ──────────────────────
# AZURE_LOG_LEVEL=error
